diff --git a/mm/swap_capacity.c b/mm/swap_capacity.c
new file mode 100644
index 000000000..5c22f7b73
--- /dev/null
+++ b/mm/swap_capacity.c
@@ -0,0 +1,150 @@
+#include "linux/types.h"
+#include <linux/sysfs.h>
+#include <linux/kobject.h>
+#include <linux/printk.h>
+#include <linux/swap.h>
+#include <linux/atomic/atomic-instrumented.h>
+
+#include "swap_capacity.h"
+
+#define SYSFS_DIR_NAME "pages"
+
+static unsigned int extend_threshold = 60;
+static unsigned int truncate_threshold = 30;
+
+static struct kobject *swap_kobject = NULL;
+static atomic_t current_event = ATOMIC_INIT(SWAP_CAPACITY_EVENT_NONE);
+
+static ssize_t truncate_threshold_show(
+    struct kobject *kobj,
+    struct kobj_attribute *attr,
+    char *buf
+) {
+    return sysfs_emit(buf, "%u\n", truncate_threshold);
+}
+
+static ssize_t truncate_threshold_store(
+    struct kobject *kobj,
+    struct kobj_attribute *attr,
+    const char *buf,
+    size_t count
+) {
+    unsigned int value;
+    int ret = kstrtouint(buf, 10, &value);
+    if (ret) {
+        return ret;
+    }
+
+    if (value > 100) {
+        return -EINVAL;
+    }
+
+    WRITE_ONCE(truncate_threshold, value);
+
+    return count;
+}
+
+static ssize_t extend_threshold_show(
+    struct kobject *kobj,
+    struct kobj_attribute *attr,
+    char *buf
+) {
+    return sysfs_emit(buf, "%u\n", extend_threshold);
+}
+
+static ssize_t extend_threshold_store(
+    struct kobject *kobj,
+    struct kobj_attribute *attr,
+    const char *buf,
+    size_t count
+) {
+    unsigned int value;
+    int ret = kstrtouint(buf, 10, &value);
+    if (ret) {
+        return ret;
+    }
+
+    if (value > 100) {
+        return -EINVAL;
+    }
+
+    WRITE_ONCE(extend_threshold, value);
+
+    return count;
+}
+
+static ssize_t free_show(struct kobject *kobj,
+                         struct kobj_attribute *attr,
+                         char *buf)
+{
+    unsigned long free_pages = get_nr_swap_pages();
+    return sysfs_emit(buf, "%lu\n", free_pages);
+}
+
+static ssize_t total_show(struct kobject *kobj,
+                          struct kobj_attribute *attr,
+                          char *buf)
+{
+    return sysfs_emit(buf, "%ld\n", READ_ONCE(total_swap_pages));
+}
+
+static ssize_t event_show(struct kobject *kobj,
+                          struct kobj_attribute *attr,
+                          char *buf)
+{
+    return sysfs_emit(buf, "%d\n", atomic_read(&current_event));
+}
+
+void swap_capacity_callback(enum swap_capacity_event_reason reason) {
+    unsigned long free_pages = get_nr_swap_pages();
+    unsigned long total_pages = READ_ONCE(total_swap_pages);
+
+    unsigned long page_use = total_pages ? ((total_pages - free_pages) * 100) / total_pages : 0;
+
+    enum swap_capacity_event event = SWAP_CAPACITY_EVENT_NONE;
+
+    if (page_use > extend_threshold) {
+        event = SWAP_CAPACITY_EVENT_EXTEND;
+    } else if (page_use < truncate_threshold) {
+        event = SWAP_CAPACITY_EVENT_TRUNC;
+    }
+
+    if (atomic_read(&current_event) == event && reason != SWAP_CAPACITY_TOTAL_CHANGED) {
+        // We have already emited this event, nothing to do
+        return;
+    }
+
+    atomic_set(&current_event, event);
+    sysfs_notify(swap_kobject, SYSFS_DIR_NAME, "event");
+}
+
+static struct kobj_attribute free_attr = __ATTR_RO(free);
+static struct kobj_attribute total_attr = __ATTR_RO(total);
+static struct kobj_attribute event_attr = __ATTR_RO(event);
+
+static struct kobj_attribute extend_threshold_attr = __ATTR_RW(extend_threshold);
+static struct kobj_attribute truncate_threshold_attr= __ATTR_RW(truncate_threshold);
+
+static struct attribute *swap_capacity_attrs[] = {
+    &free_attr.attr,
+    &total_attr.attr,
+    &event_attr.attr,
+    &extend_threshold_attr.attr,
+    &truncate_threshold_attr.attr,
+    NULL,
+};
+
+static const struct attribute_group swap_capacity_attr_group = {
+    .name = SYSFS_DIR_NAME,
+    .attrs = swap_capacity_attrs,
+};
+
+int swap_capacity_init(struct kobject *swap_kobj)
+{
+    int ret = sysfs_create_group(swap_kobj, &swap_capacity_attr_group);
+    if (!ret) {
+        swap_kobject = swap_kobj;
+    }
+
+    return ret;
+}
\ No newline at end of file
diff --git a/mm/swap_capacity.h b/mm/swap_capacity.h
new file mode 100644
index 000000000..ec128938e
--- /dev/null
+++ b/mm/swap_capacity.h
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * swap_capacity.h
+ *
+ * swap capacity management
+ */
+
+#ifndef _LINUX_SWAP_CAPACITY_H
+#define _LINUX_SWAP_CAPACITY_H
+
+#include <linux/kobject.h>
+
+enum swap_capacity_event_reason {
+    SWAP_CAPACITY_USAGE_CHANGED = 0,
+    SWAP_CAPACITY_TOTAL_CHANGED = 1
+};
+
+enum swap_capacity_event {
+    SWAP_CAPACITY_EVENT_NONE = 0,
+    SWAP_CAPACITY_EVENT_EXTEND = 1,
+    SWAP_CAPACITY_EVENT_TRUNC = 2
+};
+
+int swap_capacity_init(struct kobject *swap_kobj);
+
+void swap_capacity_callback(enum swap_capacity_event_reason reason);
+
+#endif /* _LINUX_SWAP_CAPACITY_H */
\ No newline at end of file
